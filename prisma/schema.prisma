generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id          String       @id // Supabase auth.users.id (uuid)
  email       String       @unique
  name        String?
  avatarUrl   String?
  role        String       @default("client") // "admin" | "client"
  businesses  Business[]
  credentials Credential[]
  createdAt   DateTime     @default(now())
}

model Business {
  id                 String         @id @default(cuid())
  name               String
  wabaId             String?        @unique // Meta's WhatsApp Business Account id, informational
  systemPrompt       String
  welcomeMessage     String
  businessInfo       Json
  knowledgeDoc       String? // admin-authored reference document (menu, hours, policies, FAQ) rendered FIRST in the system prompt and byte-stable across calls, so it is the part a provider can cache — see buildSystemPrompt in src/lib/prompt.ts. Null = businessInfo alone, exactly today's behavior.
  model              String? // null = inherit AppConfig.chatModel
  visionModel        String? // null = inherit AppConfig.visionModel
  audioModel         String? // null = inherit AppConfig.audioModel
  maxHistoryMessages Int            @default(20)
  summaryEnabled     Boolean        @default(true) // false = keep the raw last-N history only, no rolling summary (kill switch per business, no deploy needed) — see src/lib/ai/summarize.ts
  summaryEveryNMessages Int         @default(10) // regenerate the rolling summary once this many messages have accumulated since summarizedThroughAt, not on every flush
  dailyAiLimit       Int            @default(1000)
  replyWindowMs      Int            @default(0) // 0 = disabled = immediate reply (today's behavior). >0 = debounce window in ms before batching pending customer messages into one AI call — see reply-window-scheduler.ts
  isActive           Boolean        @default(true)
  ownerId            String
  owner              User           @relation(fields: [ownerId], references: [id])
  aiCredentialId     String?
  phoneNumbers       PhoneNumber[]
  conversations      Conversation[]
  appointments       Appointment[]
  createdAt          DateTime       @default(now())

  @@index([ownerId])
}

// A phone number registered under a Business (WABA). A Business can hold more
// than one PhoneNumber; conversations belong to the number the customer
// actually messaged, not to the WABA directly.
model PhoneNumber {
  id                   String         @id @default(cuid())
  businessId           String
  business             Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  phoneNumberId        String         @unique // Meta's opaque technical id — webhook lookup key
  displayPhone         String? // human-readable "+<código país> <número>", shown as the item title
  whatsappCredentialId String?
  isActive             Boolean        @default(true)
  conversations        Conversation[]
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  @@index([businessId])
}

// Singleton (id is always "default") holding platform-wide AI defaults —
// editable from /settings/credentials by the admin, no deploy required.
// Business.model/visionModel/audioModel fall back to this when left unset,
// so rolling out a new model to every client is a form save, not a
// migration. There is no aiCredentialId here anymore — a business without
// its own pin now resolves against its owner's ordered chain of active
// Credential rows (see getAiClient()/callWithAiCredential() in
// src/lib/ai/resolve.ts) instead of a single platform-wide default.
model AppConfig {
  id                   String   @id @default("default")
  whatsappCredentialId String?
  chatModel            String   @default("gpt-4o-mini")
  visionModel          String   @default("gpt-4o-mini")
  audioModel           String   @default("whisper-1")
  updatedAt            DateTime @updatedAt
}

model Credential {
  id           String    @id @default(cuid())
  ownerId      String
  owner        User      @relation(fields: [ownerId], references: [id])
  kind         String // "ai" | "whatsapp"
  provider     String // ai: "openai" | "openrouter" | "google" ; whatsapp: "meta"
  label        String
  encryptedKey String // AES-256-GCM: base64(iv):base64(ciphertext):base64(authTag)
  keyLast4     String
  baseUrl      String? // ai only; null = provider default
  isActive     Boolean   @default(true) // ai only; inactive credentials are skipped in the fallback chain
  priority     Int       @default(0) // ai only; ascending — lower tried first, ties broken by createdAt asc
  lastUsedAt   DateTime?
  lastError    String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([ownerId, kind])
}

model Conversation {
  id              String        @id @default(cuid())
  businessId      String // denormalized copy of phoneNumber.businessId — kept so RLS policies and scope.ts stay a single-hop join; PhoneNumber.businessId is immutable so this can't drift
  business        Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  phoneNumberId   String
  phoneNumber     PhoneNumber   @relation(fields: [phoneNumberId], references: [id], onDelete: Cascade)
  customerPhone   String
  customerName    String? // WhatsApp profile name from webhook `contacts[0].profile.name` — overwritten on every inbound message, never edited by hand
  nickname        String? // admin-set alias, takes display priority over customerName; webhook never touches this
  status          String        @default("active")
  lastMessageAt   DateTime      @default(now()) // denormalized for list ordering — bumped on every message insert
  unreadCount     Int           @default(0) // customer messages since admin last opened the thread
  pendingFlushAt  DateTime? // set (by message-handler.ts, always — not only when replyWindowMs > 0) when a customer message is awaiting dispatch; cleared (claimed) by reply-window-scheduler.ts when the window elapses
  flushLeaseUntil DateTime? // set by reply-window-scheduler.ts while a flush is in flight; prevents a crash between claim and send from orphaning pendingFlushAt forever — see reply-window-scheduler.ts's flushDueConversation
  summary         Json? // a ConversationSummary (src/lib/ai/summarize.ts): a handful of capped fields, never free prose, so its cost is predictable and each field can be sanitized on its own. Prisma types this as Json, so READERS MUST re-run validateConversationSummary — a row can predate a schema change or have been written by hand, and the type system will not catch it.
  summarizedThroughAt DateTime? // messages at or before this instant are represented by `summary`; everything after it is still loaded raw. Null = no summary yet.
  messages        Message[]
  appointments    Appointment[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@unique([phoneNumberId, customerPhone])
  @@index([businessId, lastMessageAt])
  @@index([phoneNumberId, lastMessageAt])
  @@index([pendingFlushAt])
}

model Message {
  id                 String       @id @default(cuid())
  conversationId     String
  conversation       Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role               String
  content            String
  mediaType          String       @default("text")
  mediaUrl           String?
  wamid              String?      @unique
  sentBy             String       @default("bot") // "bot" | "human" | "customer"
  status             String       @default("sent") // "sent" | "delivered" | "read" | "failed" | "pending" (bot replies start "pending" until sendFromNumber resolves — see message-handler.ts's sendAndPersistReply)
  dispatchId         String?      @unique // deterministic send-intent key (sha256 of conversationId + batched message ids) set on bot replies; the unique constraint is the no-double-send guard when the inline path and the sweep race the same conversation — see reply-window-scheduler.ts
  batchedAt          DateTime? // set by reply-window-scheduler.ts when this customer message is consumed into a batched flush — makes "pending" an explicit per-message marker instead of a createdAt-vs-lastBotMessage comparison, which can drop a message when an unrelated overlapping flush's bot reply lands with a later timestamp
  dispatchAttempts   Int          @default(0) // bounded retry counter for message-handler.ts's claimDispatch compare-and-set claim; incremented on every claim (fresh send, a P2002-conflict resume, or the periodic reaper) — mirrors WebhookEvent.maxAttempts's bounded-retry convention (outbox/repository.ts), stops a permanently-failing send from being reaped forever
  dispatchLeaseUntil DateTime? // set by claimDispatch while a send attempt is in flight; same lease pattern as Conversation.flushLeaseUntil / WebhookEvent.leaseExpiresAt — makes claiming a "status: pending" row exclusive, so a live send, a racing P2002-conflict resume, and the periodic reaper (message-handler.ts's reapStrandedSends) can never call sendFromNumber for the same row twice; its natural expiry also doubles as backoff spacing between reap attempts
  createdAt          DateTime     @default(now())

  @@index([conversationId, createdAt])
  // Serves both the flush-ceiling anchor lookup (message-handler.ts's
  // findOldestUnbatchedAt) and doFlush's pendingMessages query
  // (reply-window-scheduler.ts): both filter conversationId + sentBy +
  // batchedAt IS NULL and order by createdAt, so leading with the three
  // equality/null quals leaves createdAt pre-ordered and the anchor is a
  // LIMIT 1 with no sort. [conversationId, createdAt] above cannot serve them —
  // batchedAt is absent from it, so a forward scan skips every already-answered
  // message in the conversation first, i.e. O(conversation length) on the
  // webhook hot path. A partial index (WHERE "batchedAt" IS NULL) would be
  // smaller, but Prisma 5.22 cannot express a predicate in @@index and raw SQL
  // for it would show up as permanent `migrate diff` drift.
  @@index([conversationId, sentBy, batchedAt, createdAt])
}

model Appointment {
  id             String        @id @default(cuid())
  businessId     String
  business       Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  conversationId String?
  conversation   Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  customerPhone  String
  customerName   String
  service        String
  date           String
  time           String
  status         String        @default("pending")
  notes          String?
  createdAt      DateTime      @default(now())
}

model EventLog {
  id            String   @id @default(cuid())
  level         String // "error" | "warn" | "info"
  source        String // "webhook" | "ai" | "whatsapp-send" | "auth" | "credentials"
  message       String
  detail        Json?
  businessId    String?
  phoneNumberId String?
  createdAt     DateTime @default(now())

  @@index([createdAt])
  @@index([source, createdAt])
}

enum WebhookEventStatus {
  pending
  processing
  done
  failed
}

// Durable landing zone for every HMAC-verified webhook payload, written
// before any parsing/processing happens — see src/lib/outbox/repository.ts.
// Makes ingest resumable: a crash mid-processing leaves a row a later drain
// can retry instead of silently dropping the payload (today's fire-and-forget
// behavior). No FK to Business/PhoneNumber — that resolution happens inside
// processWebhookPayload, after this row is already durable.
model WebhookEvent {
  id             String             @id @default(cuid())
  payload        Json
  status         WebhookEventStatus @default(pending)
  attempts       Int                @default(0)
  maxAttempts    Int                @default(5) // 5 retries with backoff (repository.ts's fail()). Safe only once dispatch itself is resumable — see message-handler.ts's ingest/dispatch split and reply-window-scheduler.ts's flush lease; raising this before that landed would have retried straight into the dropped-reply bug (wamid gate returns early, reply never generated).
  nextRunAt      DateTime           @default(now())
  leaseExpiresAt DateTime?
  lockedBy       String?
  lastError      String?
  processedAt    DateTime?
  createdAt      DateTime           @default(now())

  @@index([status, nextRunAt])
  @@index([status, leaseExpiresAt])
}
